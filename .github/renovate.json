{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [
        "local>ni/python-renovate-config:recommended"
    ],
    "customManagers": [
        {
            // Update setup-python default Python version.
            "customType": "regex",
            "managerFilePatterns": [
                "/^setup-python\\/(?:action.yml|README.md)$/"
            ],
            "matchStrings": [
                "default\\s*:\\s*[\"']?(?<currentValue>.+?)[\"']?\\s",
                "By default, this action installs Python (?<currentValue>.+?)\\.\\s"
            ],
            "matchStringsStrategy": "any",
            "depNameTemplate": "python",
            "packageNameTemplate": "actions/python-versions",
            "datasourceTemplate": "github-releases",
            "versioningTemplate": "npm"
        }
    ]
}