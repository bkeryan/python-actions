{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [
        "local>ni/python-renovate-config:recommended",
        "local>ni/python-renovate-config//presets/pinGitHubActionDigestsToSemver#0ee16dac14e5bf3aa6abdba0f1d120c2f5824ae6"
    ],
    "customManagers": [
        {
            "description": "Update setup-python default Python version.",
            "customType": "regex",
            "managerFilePatterns": [
                "/^setup-python\\/(?:action.yml|README.md)$/"
            ],
            "matchStrings": [
                "python-version:\\s+default\\s*:\\s*[\"']?(?<currentValue>.+?)[\"']?\\s",
                "By default, this action installs Python (?<currentValue>.+?)\\.\\s"
            ],
            "matchStringsStrategy": "any",
            "datasourceTemplate": "python-version",
            "depNameTemplate": "python",
            "versioningTemplate": "python"
        },
        {
            "description": "Update setup-poetry default Poetry version.",
            "customType": "regex",
            "managerFilePatterns": [
                "/^setup-poetry\\/(?:action.yml|README.md)$/"
            ],
            "matchStrings": [
                "poetry-version:\\s+default\\s*:\\s*[\"']?(?<currentValue>.+?)[\"']?\\s",
                "By default, this action installs Poetry (?<currentValue>.+?)\\.\\s"
            ],
            "matchStringsStrategy": "any",
            "datasourceTemplate": "pypi",
            "depNameTemplate": "poetry",
            "versioningTemplate": "python"
        }
    ],
    "packageRules": [
        {
            "description": "Update setup-python default Python version to latest 3.13.x.",
            "matchDepNames": [
                "python"
            ],
            "allowedVersions": "< 3.14.0",
            "minimumReleaseAge": "3 days"
        },
        {
            "description": "Update setup-poetry default Poetry version to latest 2.4.x.",
            "matchDepNames": [
                "poetry"
            ],
            "allowedVersions": "< 2.5.0",
            "minimumReleaseAge": "3 days"
        }
    ]
}